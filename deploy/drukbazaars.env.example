# =====================================================================================
# DP DrukBazaars: the server's settings and secrets.
# Copy to /etc/drukbazaars/drukbazaars.env, fill in, then:  sudo chown root:drukbazaars /etc/drukbazaars/drukbazaars.env
#                                                 sudo chmod 640 /etc/drukbazaars/drukbazaars.env
# NEVER commit the filled-in copy. This example file holds no real values.
# =====================================================================================

# The website's public address (used in email links)
APP_PUBLIC_URL=https://drukbazaars.bt

# Database (made with database/01-create-database-and-user.sql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/inventorydb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=drukbazaars_app
SPRING_DATASOURCE_PASSWORD=

# Email (password reset links, order updates). Any SMTP service works, for example a
# Google Workspace / Zoho mailbox or a transactional email service.
APP_MAIL_ENABLED=true
APP_MAIL_FROM=DP DrukBazaars <no-reply@drukbazaars.bt>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Text messages (optional): a provider that sends with one web address, {to} and {text} are filled in
APP_SMS_ENABLED=false
APP_SMS_URL=

# Signed out after this long without activity (default 4h)
# SESSION_TIMEOUT=4h
# Paying from a bank account: off until the RMA gateway is connected, then rma (never test on the live site)
# APP_PAYMENTS_BANK_MODE=off
# With rma, from the merchant kit RMA gives (see DEPLOY.md, "Payments from a bank account"):
# APP_PAYMENTS_BANK_RMA_URL=https://...
# APP_PAYMENTS_BANK_RMA_BENEFICIARY_ID=
# APP_PAYMENTS_BANK_RMA_PRIVATE_KEY=/etc/drukbazaars/rma-merchant.pem
# APP_PAYMENTS_BANK_RMA_PUBLIC_KEY=/etc/drukbazaars/rma-public.pem

# Only when the website and the API have DIFFERENT addresses (not needed with deploy/nginx-drukbazaars.conf)
# APP_CORS_ALLOWED_ORIGINS=https://drukbazaars.bt,https://www.drukbazaars.bt
