# =====================================================================================
# DK/Phar Inventory: the server's settings and secrets.
# Copy to /etc/dkphar/dkphar.env, fill in, then:  sudo chown root:dkphar /etc/dkphar/dkphar.env
#                                                 sudo chmod 640 /etc/dkphar/dkphar.env
# NEVER commit the filled-in copy. This example file holds no real values.
# =====================================================================================

# The website's public address (used in email links)
APP_PUBLIC_URL=https://dkphar.bt

# Database (made with database/01-create-database-and-user.sql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/inventorydb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=dkphar_app
SPRING_DATASOURCE_PASSWORD=

# Email (password reset links, order updates). Any SMTP service works, for example a
# Google Workspace / Zoho mailbox or a transactional email service.
APP_MAIL_ENABLED=true
APP_MAIL_FROM=DK/Phar <no-reply@dkphar.bt>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Text messages (optional): a provider that sends with one web address, {to} and {text} are filled in
APP_SMS_ENABLED=false
APP_SMS_URL=

# Only when the website and the API have DIFFERENT addresses (not needed with deploy/nginx-dkphar.conf)
# APP_CORS_ALLOWED_ORIGINS=https://dkphar.bt,https://www.dkphar.bt
